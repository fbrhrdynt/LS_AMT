#!/usr/bin/env python3
import base64
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path
from urllib.parse import urlparse

APP_ROOT = Path("/opt/amt")
STATE_ROOT = Path("/var/lib/amt-updater")
REQUEST_FILE = STATE_ROOT / "request.json"
STATUS_FILE = STATE_ROOT / "status.json"
CURRENT_VERSION_FILE = (
    STATE_ROOT / "current-version"
)
LOCK_FILE = STATE_ROOT / "update.lock"
DOWNLOAD_ROOT = STATE_ROOT / "downloads"
BACKUP_ROOT = Path("/opt/amt-update-backups")
PUBLIC_KEY = Path("/etc/amt/keys/amt-release-public.pem")
SERVICE = "amt-backend.service"
RELEASE_HOST = "release.logisourcedigital.web.id"

EXCLUDED_PREFIXES = (
    ".git/",
    "backend/.env",
    "backend/venv/",
    "frontend/.env",
    "frontend/node_modules/",
    "frontend/build/",
    "storage/",
    "patches/",
    "backups/",
    ".final-hardening/",
)

DEPENDENCY_FILES = (
    "backend/requirements.txt",
    "frontend/package.json",
    "frontend/yarn.lock",
)

SEMVER_RE = re.compile(
    r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z.-]+)?$"
)


def write_status(phase, message, **extra):
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    payload = {
        "phase": phase,
        "message": message,
        "timestamp": int(time.time()),
        **extra,
    }
    tmp = STATUS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, indent=2), encoding="utf-8")
    os.chmod(tmp, 0o644)
    tmp.replace(STATUS_FILE)


def run(args, cwd=None, check=True):
    result = subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if check and result.returncode:
        raise RuntimeError(
            f"Command failed: {' '.join(args)}\n{result.stdout[-4000:]}"
        )
    return result


def sha256_file(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while True:
            chunk = handle.read(1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def semver_tuple(value):
    if not SEMVER_RE.fullmatch(str(value or "")):
        raise RuntimeError(f"Invalid semantic version: {value}")
    base = value.split("-", 1)[0]
    return tuple(int(part) for part in base.split("."))


def read_current_version():
    for path in (
        CURRENT_VERSION_FILE,
        APP_ROOT / "VERSION",
    ):
        try:
            value = path.read_text(
                encoding="utf-8"
            ).strip()
        except OSError:
            continue

        if value:
            return value

    return "0.0.0"


def write_current_version(value):
    STATE_ROOT.mkdir(
        parents=True,
        exist_ok=True,
    )
    tmp = CURRENT_VERSION_FILE.with_suffix(
        ".tmp"
    )
    tmp.write_text(
        str(value).strip() + "\n",
        encoding="utf-8",
    )
    os.chmod(tmp, 0o644)
    tmp.replace(
        CURRENT_VERSION_FILE
    )


def validate_request(data):
    required = {"target_version", "package_url", "sha256", "signature"}
    missing = sorted(key for key in required if not data.get(key))
    if missing:
        raise RuntimeError("Missing update request fields: " + ", ".join(missing))

    target = str(data["target_version"]).strip()
    if not SEMVER_RE.fullmatch(target):
        raise RuntimeError("Invalid target version")

    current = read_current_version()
    if semver_tuple(target) <= semver_tuple(current):
        raise RuntimeError(f"Refusing downgrade/non-upgrade: {current} -> {target}")

    parsed = urlparse(data["package_url"])
    if parsed.scheme != "https" or parsed.hostname != RELEASE_HOST:
        raise RuntimeError("Package URL must use approved LogiSource release host")

    digest = str(data["sha256"]).lower()
    if not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise RuntimeError("Invalid SHA256")

    if data.get("has_database_migration"):
        raise RuntimeError(
            "Automatic install is disabled for releases with database migrations"
        )

    return {**data, "target_version": target, "sha256": digest}


def download_package(url, target):
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "LogiSource-AMT-Updater/1.0"},
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        final = urlparse(response.geturl())
        if final.scheme != "https" or final.hostname != RELEASE_HOST:
            raise RuntimeError("Release download redirected outside approved host")
        with target.open("wb") as out:
            shutil.copyfileobj(response, out, length=1024 * 1024)


def verify_signature(package, signature_b64):
    if not PUBLIC_KEY.is_file():
        raise RuntimeError(f"Public release key not found: {PUBLIC_KEY}")

    signature = STATE_ROOT / "release.sig"
    try:
        raw = base64.b64decode(signature_b64, validate=True)
    except Exception as exc:
        raise RuntimeError("Release signature is not valid Base64") from exc

    signature.write_bytes(raw)
    os.chmod(signature, 0o600)

    result = run(
        [
            "/usr/bin/openssl",
            "dgst",
            "-sha256",
            "-verify",
            str(PUBLIC_KEY),
            "-signature",
            str(signature),
            str(package),
        ],
        check=False,
    )
    if result.returncode != 0 or "Verified OK" not in result.stdout:
        raise RuntimeError("Digital signature verification failed")


def excluded_member(name):
    cleaned = name.lstrip("./")
    for prefix in EXCLUDED_PREFIXES:
        if cleaned == prefix.rstrip("/") or cleaned.startswith(prefix):
            return True
    return False


def safe_extract(package, destination):
    destination = destination.resolve()

    with tarfile.open(package, "r:gz") as archive:
        members = []
        for member in archive.getmembers():
            name = member.name.lstrip("./")
            if not name:
                continue
            if excluded_member(name):
                continue
            if name.startswith("/") or ".." in Path(name).parts:
                raise RuntimeError(f"Unsafe archive path: {name}")
            if member.issym() or member.islnk():
                raise RuntimeError(f"Archive link is not allowed: {name}")

            resolved = (destination / name).resolve()
            if destination not in resolved.parents and resolved != destination:
                raise RuntimeError(f"Unsafe archive target: {name}")

            members.append(member)

        archive.extractall(destination, members=members)


def same_file(a, b):
    if not a.exists() and not b.exists():
        return True
    if not a.is_file() or not b.is_file():
        return False
    return sha256_file(a) == sha256_file(b)


def verify_dependency_compatibility(extracted):
    changed = []
    for rel in DEPENDENCY_FILES:
        current = APP_ROOT / rel
        incoming = extracted / rel
        if not same_file(current, incoming):
            changed.append(rel)

    if changed:
        raise RuntimeError(
            "Automatic updater requires unchanged dependencies. "
            "Manual upgrade required because these changed: "
            + ", ".join(changed)
        )


def database_backup(backup_dir):
    mongodump = shutil.which("mongodump")
    if not mongodump:
        raise RuntimeError("mongodump is required before automatic updates")

    env_file = APP_ROOT / "backend/.env"
    values = {}
    for raw in env_file.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip("\"'")

    mongo_url = values.get("MONGO_URL", "mongodb://127.0.0.1:27017")
    db_name = values.get("DB_NAME", "amt_database")
    archive = backup_dir / "database.archive.gz"

    run([
        mongodump,
        "--uri", mongo_url,
        "--db", db_name,
        "--archive=" + str(archive),
        "--gzip",
    ])


def code_backup(backup_dir):
    code_dir = backup_dir / "code"
    code_dir.mkdir(parents=True, exist_ok=True)

    excludes = [
        "--exclude=.git",
        "--exclude=backend/.env",
        "--exclude=backend/venv",
        "--exclude=frontend/.env",
        "--exclude=frontend/node_modules",
        "--exclude=frontend/build",
        "--exclude=storage",
        "--exclude=patches",
        "--exclude=backups",
        "--exclude=.final-hardening",
    ]

    run([
        "/usr/bin/rsync",
        "-a",
        *excludes,
        str(APP_ROOT) + "/",
        str(code_dir) + "/",
    ])

    return code_dir


def sync_code(source):
    # Temporary extraction roots default to 0700. rsync -a
    # mirrors source-root metadata to /opt/amt, so normalize
    # the source root before syncing.
    source.chmod(0o755)

    excludes = [
        "--exclude=.git",
        "--exclude=backend/.env",
        "--exclude=backend/venv",
        "--exclude=frontend/.env",
        "--exclude=frontend/node_modules",
        "--exclude=frontend/build",
        "--exclude=storage",
        "--exclude=patches",
        "--exclude=backups",
        "--exclude=.final-hardening",
    ]

    run([
        "/usr/bin/rsync",
        "-a",
        "--delete",
        "--chown=ubuntu:ubuntu",
        *excludes,
        str(source) + "/",
        str(APP_ROOT) + "/",
    ])

    run([
        "/bin/chown",
        "ubuntu:ubuntu",
        str(APP_ROOT),
    ])
    os.chmod(
        APP_ROOT,
        0o755,
    )


def build_frontend():
    yarn = shutil.which("yarn")
    if not yarn:
        raise RuntimeError("yarn not found")
    run([yarn, "build"], cwd=APP_ROOT / "frontend")


def restart_backend():
    run(["/bin/systemctl", "restart", SERVICE])


def health_check():
    url = "http://127.0.0.1:8010/api/"
    last_error = ""
    for _ in range(20):
        try:
            with urllib.request.urlopen(url, timeout=3) as response:
                if response.status == 200:
                    return
        except Exception as exc:
            last_error = str(exc)
        time.sleep(1)

    raise RuntimeError("Backend health check failed: " + last_error)


def rollback(code_dir, old_version):
    write_status(
        "rollback",
        "Update failed. Restoring previous code.",
        version=old_version,
    )
    sync_code(code_dir)
    write_current_version(
        old_version
    )
    build_frontend()
    restart_backend()
    health_check()


def main():
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    DOWNLOAD_ROOT.mkdir(parents=True, exist_ok=True)
    BACKUP_ROOT.mkdir(parents=True, exist_ok=True)

    with LOCK_FILE.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            write_status("busy", "Another update is already running")
            return 2

        try:
            request = json.loads(
                REQUEST_FILE.read_text(encoding="utf-8")
            )
            request = validate_request(request)

            target_version = request["target_version"]
            old_version = read_current_version()

            write_status(
                "checking",
                f"Preparing update {old_version} -> {target_version}",
                current_version=old_version,
                target_version=target_version,
            )

            package = DOWNLOAD_ROOT / f"amt-{target_version}.tar.gz"

            write_status(
                "downloading",
                "Downloading signed release package",
                target_version=target_version,
            )
            download_package(request["package_url"], package)

            if sha256_file(package) != request["sha256"]:
                raise RuntimeError("SHA256 mismatch")

            write_status(
                "verifying",
                "Verifying digital signature",
                target_version=target_version,
            )
            verify_signature(package, request["signature"])

            with tempfile.TemporaryDirectory(prefix="amt-update-") as temp:
                extracted = Path(temp)
                safe_extract(package, extracted)
                verify_dependency_compatibility(extracted)

                stamp = time.strftime("%Y%m%d-%H%M%S")
                backup_dir = BACKUP_ROOT / f"{old_version}-{stamp}"
                backup_dir.mkdir(parents=True, exist_ok=True)

                write_status(
                    "backup",
                    "Creating database and code backup",
                    backup=str(backup_dir),
                )

                database_backup(backup_dir)
                code_dir = code_backup(backup_dir)

                try:
                    write_status(
                        "installing",
                        "Installing release files",
                        target_version=target_version,
                    )
                    sync_code(extracted)

                    write_status(
                        "building",
                        "Building frontend",
                        target_version=target_version,
                    )
                    build_frontend()

                    write_current_version(
                        target_version
                    )

                    write_status(
                        "restarting",
                        "Restarting AMT backend",
                        target_version=target_version,
                    )
                    restart_backend()
                    health_check()

                except Exception:
                    rollback(code_dir, old_version)
                    raise

            write_status(
                "success",
                f"AMT updated successfully to {target_version}",
                current_version=target_version,
                target_version=target_version,
            )
            return 0

        except Exception as exc:
            write_status("failed", str(exc))
            return 1


if __name__ == "__main__":
    sys.exit(main())
