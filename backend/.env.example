APP_ENV="production"
MONGO_URL="mongodb://127.0.0.1:27017"
DB_NAME="amt_database"

# Minimum 32 random characters; 64+ recommended.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
ACCESS_TTL_MINUTES="30"
REFRESH_TTL_DAYS="7"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

FRONTEND_URL="https://amt.logisourcedigital.web.id"
# Optional comma-separated additional trusted browser origins. Never use * in production.
CORS_ORIGINS=""
# Optional comma-separated additional Host headers.
ALLOWED_HOSTS=""

STORAGE_ROOT="/opt/amt/storage"

# LS CRM license integration. Keep the real license key only in backend/.env.
LOGI_LICENSE_API_BASE="https://crm.logisourcedigital.web.id"
LOGI_LICENSE_KEY="replace-with-ls-crm-license-key"
LOGI_LICENSE_PRODUCT_SLUG="ls-amt-baroid-uae"
